# Copy to .env (or export the variables) and fill in your own provider.
# 127.0.0.1 = only this computer. Use 0.0.0.0 to serve others (requires SHELF_PASSWORD).
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Set a password to require HTTP Basic auth for changes. Leave empty only on a private machine.
SHELF_PASSWORD=
# true = anyone with the link can view the shelf (changes still need the password).
SHELF_PUBLIC=false

# Vision model: any OpenAI-compatible /chat/completions endpoint that accepts image_url inputs.
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# Spine image generation. IMAGE_API_STYLE:
#   none          use the straightened photo crop as the spine (no image API, cheapest)
#   openai-edits  POST {IMAGE_BASE_URL}/images/edits (multipart, OpenAI style)
#   json-image    POST {IMAGE_BASE_URL}/images/generations with {"image":"data:..."} (e.g. Volcano Ark Seedream)
IMAGE_API_STYLE=none
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x2048

# Cost guards
MAX_BOOKS_PER_PHOTO=10
MAX_PHOTOS_PER_DAY=20
